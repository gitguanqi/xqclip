{
  "name": "xqclip",
  "version": "0.1.2",
  "description": "This is a js package that provides image cutting and export.",
  "llms": "./llms.txt",
  "agents": "./skills/xqclip/SKILL.md",
  "main": "lib/js/xqclip.js",
  "module": "lib/js/xqclip-esm.mjs",
  "types": "lib/types/index.d.ts",
  "browser": "lib/js/xqclip.min.js",
  "unpkg": "lib/js/xqclip.min.js",
  "jsdelivr": "lib/js/xqclip.min.js",
  "files": [
    "lib",
    "llms.txt",
    "skills",
    "zh.md"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/js/xqclip-esm.mjs",
      "require": "./lib/js/xqclip.js",
      "default": "./lib/js/xqclip.js"
    },
    "./vue": {
      "types": "./lib/types/vue/index.d.ts",
      "import": "./lib/vue/xqclip.js",
      "default": "./lib/vue/xqclip.js"
    },
    "./css/xqclip.css": "./lib/css/xqclip.css",
    "./css/xqclip.min.css": "./lib/css/xqclip.min.css",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "node --test test/xqclip.test.mjs",
    "test:browser": "node scripts/demo-server.mjs",
    "commitlint": "commitlint --edit",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitguanqi/xqclip.git"
  },
  "keywords": [
    "clip",
    "xqclip"
  ],
  "author": "gitguanqi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/gitguanqi/xqclip/issues"
  },
  "homepage": "https://github.com/gitguanqi/xqclip#readme",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2"
  }
}
